# ---------------------------------------------------------------------------
# Smart Cover Letter Agent — frontend environment
# Copy to `.env.local` and adjust. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Django REST API base URL.
#   - Leave EMPTY to use the Vite dev proxy (see vite.config.ts), which
#     forwards /api/* to http://localhost:8000 during development.
#   - Set an absolute URL for staging/production, e.g.
#         VITE_API_URL=https://api.example.com/api
VITE_API_URL=

# Run the UI against the in-browser mock transport instead of a live backend.
# Useful before the Django API is running. When unset, mocks are enabled only
# if VITE_API_URL is empty.
#   true  = always use mocks
#   false = always use the real HTTP transport
VITE_USE_MOCKS=

# Request timeout in milliseconds.
VITE_API_TIMEOUT=20000

# Dev-server port (optional, defaults to 5173).
PORT=5173
