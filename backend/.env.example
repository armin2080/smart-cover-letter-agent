# ---------------------------------------------------------------------------
# Smart Cover Letter Agent — backend environment
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django
# PRODUCTION: set a real key. The app refuses to start when DJANGO_DEBUG is
# false and this is still the placeholder, because a predictable key lets
# anyone forge session cookies and tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-change-only-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO

# Origins allowed to call the API directly (the Vite proxy makes this optional
# during development).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production. Behind Cloudflare the request arrives over HTTP from
# cloudflared, so Django needs this to know the original request was HTTPS —
# without it `request.is_secure()` is false and CSRF rejects every POST.
#   CSRF_TRUSTED_ORIGINS=https://sca.example.com
CSRF_TRUSTED_ORIGINS=

# Where `vite build` wrote its output. Django serves the SPA from this
# directory; it must exist or the catch-all returns 404.
# Default: <repo>/frontend/dist
SPA_ROOT=

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# Groq — cover letter generation.
# When empty, the backend produces a deterministic draft grounded strictly in
# the user's own profile so the feature still works offline.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Public feature flags
# ---------------------------------------------------------------------------
# Read by the frontend via GET /api/config/ before anyone signs in.

# Self-service registration. OFF by default: the pilot is invitation-only, so
# accounts are created deliberately (admin panel or `createsuperuser`) rather
# than by anyone who finds the site. Turn on to let visitors sign themselves up.
REGISTRATION_ENABLED=false

# ---------------------------------------------------------------------------
# Job source providers  (COMPLIANCE GATE)
# ---------------------------------------------------------------------------
# Two independent conditions must both hold before any live request is made to
# a third-party platform:
#   1. PROVIDER_<NAME>_ENABLED=true
#   2. PROVIDER_<NAME>_AUTHORIZATION_REFERENCE=<non-empty reference>
#
# An MIT licence on a scraper library authorises the CODE, not access to the
# PLATFORM. Enabling a provider without a recorded authorization leaves it
# DISABLED_AUTHORIZATION_PENDING and no request is ever made.
#
# Default for every platform: OFF.  See docs/provider-authorization-matrix.md.

# TEST MODE — evaluation only, not permission.
# Setting this true waives condition 2 so the adapters can be exercised before
# any agreement exists. Providers it enables report "Test mode — no
# authorization" and are never reported as authorized. Set one or more
# PROVIDER_<NAME>_ENABLED=true alongside it to pick which ones to test.
# Leave false for anything beyond evaluation.
PROVIDER_TEST_MODE=false

PROVIDER_LINKEDIN_ENABLED=false
PROVIDER_LINKEDIN_AUTHORIZATION_REFERENCE=

PROVIDER_STEPSTONE_ENABLED=false
PROVIDER_STEPSTONE_AUTHORIZATION_REFERENCE=

PROVIDER_STELLENWERK_ENABLED=false
PROVIDER_STELLENWERK_AUTHORIZATION_REFERENCE=

# Manual import performs no third-party collection, so it needs no authorization.
PROVIDER_MANUAL_ENABLED=true

# Synthetic fallback when no live source is available, so the workflow stays
# usable and the run explains why.
SAMPLE_DATA_ENABLED=true

# Adapter HTTP behaviour (authorized providers only). 401/403/429 are NEVER
# retried; only transient failures are.
SOURCE_HTTP_TIMEOUT_SECONDS=20
SOURCE_HTTP_MAX_ATTEMPTS=3
SOURCE_MAX_RESULTS=50

# Detail fetches per source (descriptions improve matching).
SOURCE_ENRICH_LIMIT=6

# Whether something outside the web process actually runs scheduled searches.
#
# The application records *when* a search should run; it cannot trigger itself.
# Without an external scheduler, "Automatic search" is only a saved preference,
# and the UI says so rather than counting down to a run that never happens.
#
# To enable, add a cron entry, then set this to true so the UI reports the
# schedule as live. Tick more often than any schedule needs to run: the command
# starts only users whose next run is actually due, so a 15-minute tick does not
# mean a search every 15 minutes.
#
#   0,15,30,45 * * * * cd /path/to/backend && .venv/bin/python manage.py run_scheduled_searches
AUTO_SEARCH_SCHEDULER_ENABLED=false

# CV upload limits
CV_MAX_UPLOAD_BYTES=10485760
