# ---------------------------------------------------------------------------
# Smart Cover Letter Agent — backend environment
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO

# Origins allowed to call the API directly (the Vite proxy makes this optional
# during development).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# Groq — cover letter generation.
# When empty, the backend produces a deterministic draft grounded strictly in
# the user's own profile so the feature still works offline.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Job source providers  (COMPLIANCE GATE)
# ---------------------------------------------------------------------------
# Two independent conditions must both hold before any live request is made to
# a third-party platform:
#   1. PROVIDER_<NAME>_ENABLED=true
#   2. PROVIDER_<NAME>_AUTHORIZATION_REFERENCE=<non-empty reference>
#
# An MIT licence on a scraper library authorises the CODE, not access to the
# PLATFORM. Enabling a provider without a recorded authorization leaves it
# DISABLED_AUTHORIZATION_PENDING and no request is ever made.
#
# Default for every platform: OFF.  See docs/provider-authorization-matrix.md.

PROVIDER_LINKEDIN_ENABLED=false
PROVIDER_LINKEDIN_AUTHORIZATION_REFERENCE=

PROVIDER_STEPSTONE_ENABLED=false
PROVIDER_STEPSTONE_AUTHORIZATION_REFERENCE=

PROVIDER_STELLENWERK_ENABLED=false
PROVIDER_STELLENWERK_AUTHORIZATION_REFERENCE=

# Manual import performs no third-party collection, so it needs no authorization.
PROVIDER_MANUAL_ENABLED=true

# Synthetic fallback when no live source is available, so the workflow stays
# usable and the run explains why.
SAMPLE_DATA_ENABLED=true

# Adapter HTTP behaviour (authorized providers only). 401/403/429 are NEVER
# retried; only transient failures are.
SOURCE_HTTP_TIMEOUT_SECONDS=20
SOURCE_HTTP_MAX_ATTEMPTS=3
SOURCE_MAX_RESULTS=50

# Detail fetches per source (descriptions improve matching).
SOURCE_ENRICH_LIMIT=6

# CV upload limits
CV_MAX_UPLOAD_BYTES=10485760
